/*5. Dado el costo de una compra y el dinero entregado por el cliente, calcular el
cambio y desglosarlo en billetes y monedas (500, 200, 100, 50, 20, 10, 5, 2 y 1).*/

#include<stdio.h>
int main(){
//Variables para solicitar datos al usuario
int costocompra;
int dineroentregado;
//Variables para poder dar el cambio y desglosarlo en billetes y monedas

int cambio;
int billetes;
int monedas;

//variables para registrar las diferentes denominaciones

int billetede500;

int billetede200;

